{
  "manifest_version": 3,
  "name": "Yandex Search AdBlocker",
  "version": "1.1",
  "description": "Blocks ads in Yandex search results",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://yandex.ru/*",
    "*://yandex.com/*",
    "*://ya.ru/*",
    "*://*.yandex.ru/*",
    "*://*.yandex.com/*",
    "*://*.ya.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://yandex.ru/search*",
        "*://yandex.com/search*",
        "*://ya.ru/search*",
        "*://*.yandex.ru/search*",
        "*://*.yandex.com/search*",
        "*://*.ya.ru/search*"
      ],
      "js": ["yandex-ad-blocker/content.js"],
      "css": ["yandex-ad-blocker/styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "yandex-ad-blocker/popup.html",
    "default_title": "Yandex Search AdBlocker"
  },
  "icons": {
    "16": "yandex-ad-blocker/icon16.png",
    "48": "yandex-ad-blocker/icon48.png",
    "128": "yandex-ad-blocker/icon128.png"
  }
}
